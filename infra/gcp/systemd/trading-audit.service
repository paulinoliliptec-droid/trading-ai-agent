[Unit]
Description=Trading AI Agent: auditoria semanal (Telegram)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/trading/image
ExecStart=/usr/bin/docker run --rm --name audit --log-driver=gcplogs --env-file /etc/trading/env \
  -v /var/lib/trading/models_artifacts:/app/models_artifacts:ro ${IMAGE} \
  python scripts/weekly_audit.py
